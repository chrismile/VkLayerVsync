{
  "file_format_version" : "1.1.0",
  "layer" : {
    "name": "VK_LAYER_CHRISMILE_vsync",
    "type": "GLOBAL",
    "library_path": "${VK_LAYER_LIBRARY_PATH}",
    "api_version": "1.3.234",
    "implementation_version": "1",
    "description": "Vsync layer - https://github.com/chrismile/VkLayerVsync",
    "functions": {
      "vkGetInstanceProcAddr": "VsyncLayer_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "VsyncLayer_GetDeviceProcAddr"
    },
    "enable_environment": {
      "VK_VSYNC": "1"
    }
  }
}
